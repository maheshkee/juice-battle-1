#include <Arduino_RouterBridge.h>
#include "HX711Zephyr.h"

#define DT_PIN  4
#define SCK_PIN 5

HX711Zephyr scale;

void setup() {
  Bridge.begin();
  Monitor.begin();
  Monitor.println("[DIAG] Starting...");
  scale.begin(DT_PIN, SCK_PIN);
  scale.start(2000);
  scale.setCalFactor(1.0f);
  Monitor.println("[DIAG] Ready");
}

void loop() {
  scale.update();
  if (scale.isFresh()) {
    Monitor.print("[DIAG] raw=");
    Monitor.print(scale.getRaw());
    Monitor.print("  grams=");
    Monitor.println(scale.getGrams(), 1);
  }
  delay(500);
}
